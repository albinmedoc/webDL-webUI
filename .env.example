# Copy to .env for local dev. Loaded automatically by:
#   pnpm run dev:server
#   pnpm run dev:server:watch
# Production scripts (start, start:prod) do NOT load this file — set env vars
# via Docker / containerEnv / your process supervisor instead.
#
# Anything set here is treated as "pinned by env" by the Settings UI: those
# rows show as locked and the UI will refuse edits until you remove the line.

# --- Usenet (NNTP server) ---
# USENET_ENABLED=true
# USENET_HOST=news.example.com
# USENET_PORT=563
# USENET_SSL=true
# USENET_USER=
# USENET_PASS=
# USENET_CONNECTIONS=20
# USENET_GROUPS=alt.binaries.boneless

# --- Archive & PAR2 ---
# USENET_PAR2_PERCENT=10
# USENET_RAR_SIZE_MB=50
# USENET_MAX_CONCURRENT=2
# USENET_MIN_FREE_DISK_MULTIPLIER=3

# --- Subject & nyuu ---
# USENET_SUBJECT_TEMPLATE=[{filename}] - "{rarname}" yEnc ({part}/{total})
# USENET_NFO_PATH=
# USENET_NYUU_EXTRA_ARGS=

# --- Release naming ---
# USENET_RELEASE_GROUP=SVTDL
# USENET_RELEASE_NAME_TEMPLATE={show}.S{season}E{episode}.{quality}.WEB-DL.h264-{group}

# --- Paths ---
# USENET_WORK_DIR=/data/work
# NZB_OUTPUT_DIR=/data/nzb
# NZB_RETENTION_DAYS=0
# DOWNLOAD_OUTPUT_DIR=/data/downloads

# --- Indexer hook ---
# INDEXER_HOOK_SCRIPT=
